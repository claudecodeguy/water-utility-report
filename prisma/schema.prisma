generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum RiskLevel {
  safe
  low
  moderate
  high
  critical
}

enum PublishStatus {
  draft
  review
  approved
  published
  archived
}

// ─── STATES ────────────────────────────────────────────────────────────────────

model State {
  id               String        @id @default(uuid())
  slug             String        @unique
  name             String
  abbreviation     String        @unique
  fips_code        String?       @unique
  summary          String?
  meta_title       String?
  meta_description String?
  publish_status   PublishStatus @default(draft)
  noindex          Boolean       @default(false)
  last_published_at DateTime?
  content_version  Int           @default(1)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  cities      City[]
  utilities   Utility[]
  well_guide  WellGuide?
  labs        Lab[]
}

// ─── CITIES ────────────────────────────────────────────────────────────────────

model City {
  id               String        @id @default(uuid())
  slug             String        @unique
  name             String
  state_id         String
  population       Int?
  lat              Float?
  lng              Float?
  summary          String?
  meta_title       String?
  meta_description String?
  publish_status   PublishStatus @default(draft)
  noindex          Boolean       @default(false)
  last_published_at DateTime?
  content_version  Int           @default(1)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  state     State     @relation(fields: [state_id], references: [id])
  utilities Utility[]
}

// ─── UTILITIES ─────────────────────────────────────────────────────────────────

model Utility {
  id                     String        @id @default(uuid())
  slug                   String        @unique
  name                   String
  pwsid                  String        @unique
  state_id               String
  city_id                String?
  address                String?
  city_served            String?
  county_served          String?
  phone                  String?
  website                String?
  population_served      Int
  service_type           String?
  ownership_type         String?
  risk_level             RiskLevel     @default(safe)
  risk_score             Float?
  ccr_url                String?
  ccr_year               Int?
  meta_title             String?
  meta_description       String?
  publish_status         PublishStatus @default(draft)
  noindex                Boolean       @default(false)
  last_published_at      DateTime?
  content_version        Int           @default(1)
  // Provenance
  source_type            String?
  source_url             String?
  ingestion_date         DateTime?
  last_verification_date DateTime?
  transform_version      String?
  confidence_score       Float?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  state                State               @relation(fields: [state_id], references: [id])
  city                 City?               @relation(fields: [city_id], references: [id])
  service_areas        ServiceArea[]
  zip_utility_matches  ZipUtilityMatch[]
  ccr_reports          CcrReport[]
  violations           Violation[]
  utility_contaminants UtilityContaminant[]
  pfas_records         PfasRecord[]
  pfas_statuses        PfasOfficialStatus[]
  signals              OutreachSignal[]
}

// ─── SERVICE AREAS ─────────────────────────────────────────────────────────────

model ServiceArea {
  id                  String   @id @default(uuid())
  utility_id          String
  geometry            Json?
  boundary_source     String?
  boundary_confidence Float    @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  utility Utility @relation(fields: [utility_id], references: [id])
}

// ─── ZIP → UTILITY MATCHES ─────────────────────────────────────────────────────

model ZipUtilityMatch {
  id               String   @id @default(uuid())
  zip_code         String
  utility_id       String
  match_confidence Float    @default(0)
  match_method     String?
  is_primary       Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  utility Utility @relation(fields: [utility_id], references: [id])

  @@unique([zip_code, utility_id])
  @@index([zip_code])
}

// ─── CCR REPORTS ───────────────────────────────────────────────────────────────

model CcrReport {
  id               String    @id @default(uuid())
  utility_id       String
  report_year      Int
  report_url       String?
  ingestion_date   DateTime?
  raw_text         String?
  parsed_at        DateTime?
  parse_version    String?
  confidence_score Float     @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  utility Utility @relation(fields: [utility_id], references: [id])

  @@unique([utility_id, report_year])
}

// ─── VIOLATIONS ────────────────────────────────────────────────────────────────

model Violation {
  id                String    @id @default(uuid())
  utility_id        String
  contaminant_code  String?
  contaminant_name  String?
  violation_type    String?
  violation_date    DateTime?
  resolution_date   DateTime?
  is_health_based   Boolean   @default(false)
  severity          String?
  description       String?
  source_url        String?
  ingestion_date    DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  utility Utility @relation(fields: [utility_id], references: [id])

  @@index([utility_id])
}

// ─── CONTAMINANTS ──────────────────────────────────────────────────────────────

model Contaminant {
  id                 String        @id @default(uuid())
  slug               String        @unique
  name               String
  short_name         String?
  category           String?
  risk_level         RiskLevel     @default(safe)
  epa_limit          String?
  epa_limit_note     String?
  summary            String?
  definition         String?
  why_care           String?
  who_is_affected    String?
  detection          String?
  well_water_relevant Boolean      @default(false)
  affected_states    String[]
  meta_title         String?
  meta_description   String?
  publish_status     PublishStatus @default(draft)
  noindex            Boolean       @default(false)
  last_published_at  DateTime?
  content_version    Int           @default(1)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  utility_contaminants UtilityContaminant[]
}

// ─── UTILITY CONTAMINANTS ──────────────────────────────────────────────────────

model UtilityContaminant {
  id                     String    @id @default(uuid())
  utility_id             String
  contaminant_id         String
  detected               Boolean   @default(false)
  level                  Float?
  unit                   String?
  status                 RiskLevel @default(safe)
  year_tested            Int?
  // Provenance
  source_type            String?
  source_url             String?
  ingestion_date         DateTime?
  last_verification_date DateTime?
  transform_version      String?
  confidence_score       Float?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  utility     Utility     @relation(fields: [utility_id], references: [id])
  contaminant Contaminant @relation(fields: [contaminant_id], references: [id])

  @@unique([utility_id, contaminant_id])
}

// ─── TREATMENT METHODS ─────────────────────────────────────────────────────────

model TreatmentMethod {
  id                String        @id @default(uuid())
  slug              String        @unique
  name              String
  short_name        String?
  summary           String?
  solves            String[]
  does_not_solve    String[]
  point_of_use      Boolean       @default(false)
  whole_home        Boolean       @default(false)
  maintenance       String?
  cost_range        String?
  meta_title        String?
  meta_description  String?
  publish_status    PublishStatus @default(draft)
  noindex           Boolean       @default(false)
  last_published_at DateTime?
  content_version   Int           @default(1)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

// ─── WELL GUIDES ───────────────────────────────────────────────────────────────

model WellGuide {
  id                   String        @id @default(uuid())
  state_id             String        @unique
  slug                 String        @unique
  common_contaminants  String[]
  testing_frequency    String?
  regulations_summary  String?
  meta_title           String?
  meta_description     String?
  publish_status       PublishStatus @default(draft)
  noindex              Boolean       @default(false)
  last_published_at    DateTime?
  content_version      Int           @default(1)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  state State @relation(fields: [state_id], references: [id])
}

// ─── LABS ──────────────────────────────────────────────────────────────────────

model Lab {
  id                     String    @id @default(uuid())
  slug                   String    @unique
  name                   String
  state_id               String
  website                String?
  service_area           String?
  certifications         String[]
  tests_offered          String[]
  last_updated           DateTime?
  // Provenance
  source_type            String?
  source_url             String?
  ingestion_date         DateTime?
  last_verification_date DateTime?
  transform_version      String?
  confidence_score       Float?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  state State @relation(fields: [state_id], references: [id])
}

// ─── PAGE REGISTRY ─────────────────────────────────────────────────────────────

model PageRegistry {
  id              String        @id @default(uuid())
  entity_type     String
  entity_id       String
  slug            String        @unique
  canonical_url   String?
  publish_status  PublishStatus @default(draft)
  noindex         Boolean       @default(false)
  robots_override String?
  last_crawled_at DateTime?
  indexed_at      DateTime?
  content_hash    String?
  content_version Int           @default(1)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@index([entity_type, entity_id])
}

// ─── PAGE PUBLISH RULES ────────────────────────────────────────────────────────

model PagePublishRule {
  id                       String   @id @default(uuid())
  entity_type              String   @unique
  min_confidence           Float    @default(0.7)
  require_human_review     Boolean  @default(true)
  auto_publish             Boolean  @default(false)
  noindex_below_confidence Float    @default(0.6)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

// ─── SOURCE REGISTRY ───────────────────────────────────────────────────────────

model SourceRegistry {
  id                         String    @id @default(uuid())
  source_type                String    @unique
  name                       String
  base_url                   String?
  last_ingested_at           DateTime?
  ingestion_cadence          String?
  terms_allow_republication  Boolean   @default(false)
  notes                      String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
}

// ─── PFAS WATCHLIST ────────────────────────────────────────────────────────────

model PfasAnalyte {
  id          String   @id @default(uuid())
  code        String   @unique  // e.g. "PFOA", "PFOS", "HFPO-DA"
  name        String            // full official name
  short_name  String?           // abbreviation / trade name
  cas_number  String?
  epa_mcl_ppt Float?            // finalized EPA MCL in ppt (null if not yet set)
  epa_hal_ppt Float?            // health advisory level in ppt
  ucmr_round  String?           // e.g. "UCMR 5"
  note        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  records PfasRecord[]
}

model PfasRecord {
  id                  String    @id @default(uuid())
  pwsid               String
  analyte_id          String

  // Raw source fields — preserved exactly as provided by source
  raw_result_value    String
  raw_unit            String
  raw_detection_flag  String    // e.g. "Detected above MRL" / "Not Detected above MRL"
  raw_reporting_limit String?

  sample_date         DateTime
  sample_point        String?

  // Provenance
  source_dataset      String    // e.g. "EPA UCMR 5"
  source_version      String?   // e.g. "2024-11"
  source_url          String
  source_published_at DateTime?
  source_retrieved_at DateTime
  source_hash         String    @unique   // SHA-256 of raw record for dedup
  raw_payload         Json                // immutable snapshot

  // Validation
  validated           Boolean   @default(false)
  validation_errors   String[]
  suppressed          Boolean   @default(false)
  suppressed_reason   String?
  last_seen_at        DateTime  @default(now())
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  utility Utility?    @relation(fields: [pwsid], references: [pwsid])
  analyte PfasAnalyte @relation(fields: [analyte_id], references: [id])

  @@index([pwsid])
  @@index([analyte_id])
  @@index([sample_date])
}

model PfasOfficialStatus {
  id                String    @id @default(uuid())
  pwsid             String
  status_type       String    // e.g. "MCL_EXCEEDANCE", "VIOLATION", "ENFORCEMENT_ACTION"
  raw_status_label  String    // exact wording from source
  raw_status_reason String?
  source_dataset    String
  source_url        String
  effective_date    DateTime?
  retrieved_at      DateTime
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  utility Utility? @relation(fields: [pwsid], references: [pwsid])

  @@index([pwsid])
}

// ─── LEGAL REVIEW FLAGS ────────────────────────────────────────────────────────

model LegalReviewFlag {
  id          String    @id @default(uuid())
  entity_type String
  entity_id   String
  flag_type   String
  flag_reason String?
  flagged_at  DateTime  @default(now())
  reviewed_at DateTime?
  reviewer_id String?
  resolution  String?
  resolved_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([entity_type, entity_id])
}

// ─── VIOLATION ALERTS ──────────────────────────────────────────────────────────

model ViolationAlert {
  id         String   @id @default(uuid())
  email      String
  pwsid      String
  created_at DateTime @default(now())

  @@unique([email, pwsid])
  @@index([pwsid])
  @@index([email])
}

// ─── CONTENT EXPERIMENTS ───────────────────────────────────────────────────────

model ContentExperiment {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  entity_type   String
  variant_a     Json
  variant_b     Json
  traffic_split Float     @default(0.5)
  start_date    DateTime?
  end_date      DateTime?
  winner        String?
  status        String    @default("draft")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

// ─── OUTREACH PIPELINE ─────────────────────────────────────────────────────────

model OutreachSignal {
  id                String   @id @default(uuid()) @db.Uuid
  signal_type       String   // 'violation' | 'pfas_detection' | 'contaminant_exceedance' | 'news_event'
  pwsid             String?
  utility_id        String?
  state             String
  city              String?
  contaminant       String?
  measured_value    Decimal?
  threshold         Decimal?
  units             String?
  population_served Int?
  raw_data          Json
  source_url        String?
  detected_at       DateTime @default(now())
  status            String   @default("new") // 'new' | 'scored' | 'queued' | 'skipped' | 'pitched'

  utility Utility?       @relation(fields: [utility_id], references: [id])
  story   OutreachStory?

  @@index([status, detected_at(sort: Desc)])
  @@index([state, contaminant])
  @@map("outreach_signals")
}

model OutreachStory {
  id                   String   @id @default(uuid()) @db.Uuid
  signal_id            String   @unique @db.Uuid
  newsworthiness_score Int
  verdict              String   // 'pitch' | 'skip' | 'watchlist'
  primary_angle        String?
  headline_suggestion  String?
  key_stat             String?
  population_affected  Int?
  target_outlet_tier   String?  // 'national' | 'state' | 'metro' | 'local'
  comparable_context   String?
  reasoning            String?
  scored_at            DateTime @default(now())

  signal  OutreachSignal @relation(fields: [signal_id], references: [id], onDelete: Cascade)
  pitches OutreachPitch[]

  @@index([newsworthiness_score(sort: Desc), verdict])
  @@map("outreach_stories")
}

model OutreachJournalist {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  email             String   @unique
  outlet            String
  outlet_url        String?
  outlet_da         Int?
  beat              String?
  state             String?
  city              String?
  dmas              String[]
  recent_topics     String[]
  recent_articles   Json?
  notes             String?
  last_contacted_at DateTime?
  contacted_count   Int      @default(0)
  reply_count       Int      @default(0)
  pickup_count      Int      @default(0)
  status            String   @default("active") // 'active' | 'unsubscribed' | 'bounced' | 'blacklisted'
  created_at        DateTime @default(now())

  pitches OutreachPitch[]

  @@index([state, beat, status])
  @@map("outreach_journalists")
}

model OutreachPitch {
  id                   String   @id @default(uuid()) @db.Uuid
  story_id             String   @db.Uuid
  journalist_id        String   @db.Uuid
  subject              String
  body                 String
  personalization_note String?
  status               String   @default("draft") // 'draft' | 'approved' | 'sent' | 'bounced' | 'replied' | 'published' | 'rejected'
  draft_created_at     DateTime @default(now())
  approved_at          DateTime?
  approved_by          String?
  sent_at              DateTime?
  replied_at           DateTime?
  reply_text           String?
  reply_sentiment      String?
  published_url        String?
  backlink_found       Boolean  @default(false)
  notes                String?

  story      OutreachStory      @relation(fields: [story_id], references: [id], onDelete: Cascade)
  journalist OutreachJournalist @relation(fields: [journalist_id], references: [id])

  @@index([status, draft_created_at(sort: Desc)])
  @@index([journalist_id])
  @@map("outreach_pitches")
}

// ── Conversion / Email Capture ─────────────────────────────────────────────

model EmailSubscriber {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  status             String   @default("active") // active | unsubscribed | bounced | suppressed
  consent_text       String?
  consent_timestamp  DateTime @default(now())
  source_page_url    String?
  source_cta         String?
  source_context     String?
  first_utility_slug String?
  first_pwsid        String?
  first_state        String?
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  referrer           String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  utility_subscriptions    UtilitySubscription[]
  email_report_requests    EmailReportRequest[]
  monetization_signals     MonetizationInterestSignal[]

  @@map("email_subscribers")
}

model UtilitySubscription {
  id                  String   @id @default(uuid()) @db.Uuid
  email_subscriber_id String   @db.Uuid
  email               String
  utility_slug        String
  utility_name        String?
  pwsid               String?
  state               String?
  alert_preferences   Json     @default("[]")
  status              String   @default("active")
  source_page_url     String?
  source_cta          String?
  cta_location        String?
  form_version        String?
  experiment_variant  String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  subscriber EmailSubscriber @relation(fields: [email_subscriber_id], references: [id])

  @@unique([email, utility_slug])
  @@index([utility_slug])
  @@index([email])
  @@index([created_at(sort: Desc)])
  @@map("utility_subscriptions")
}

model EmailReportRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  email_subscriber_id String?  @db.Uuid
  email               String
  utility_slug        String?
  utility_name        String?
  pwsid               String?
  state               String?
  report_snapshot     Json?
  delivery_status     String   @default("not_configured") // pending | sent | failed | not_configured
  delivery_error      String?
  source_page_url     String?
  cta_location        String?
  created_at          DateTime @default(now())

  subscriber EmailSubscriber? @relation(fields: [email_subscriber_id], references: [id])

  @@index([email])
  @@index([utility_slug])
  @@index([created_at(sort: Desc)])
  @@map("email_report_requests")
}

model AdminNotificationLog {
  id              String   @id @default(uuid()) @db.Uuid
  recipient       String
  conversion_type String
  email           String
  utility_slug    String?
  pwsid           String?
  source_page_url String?
  delivery_status String   @default("pending") // sent | failed
  error_message   String?
  sent_at         DateTime @default(now())

  @@index([sent_at(sort: Desc)])
  @@map("admin_notification_log")
}

model MonetizationInterestSignal {
  id                  String   @id @default(uuid()) @db.Uuid
  email_subscriber_id String?  @db.Uuid
  email               String
  utility_slug        String?
  pwsid               String?
  state               String?
  interest_type       String   // water_testing | PFAS_testing | lead_testing | nitrate_testing | certified_lab | treatment_guidance | filter_guidance | reverse_osmosis | activated_carbon | private_well | CCR_updates | source_data_updates
  source_page_url     String?
  source_cta          String?
  created_at          DateTime @default(now())

  subscriber EmailSubscriber? @relation(fields: [email_subscriber_id], references: [id])

  @@index([email])
  @@index([interest_type])
  @@index([created_at(sort: Desc)])
  @@map("monetization_interest_signals")
}
